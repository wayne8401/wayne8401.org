# Copy the lines you need into your shell or a process manager. Only one model provider is required.

# Free, local open-source models (install from ollama.com, then: ollama pull qwen3:8b)
# OLLAMA_URL=http://localhost:11434/v1

# Free hosted open models
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# Any OpenAI-compatible server (LM Studio, vLLM, llama.cpp, LocalAI, Jan...)
# OPENAI_COMPAT_URL=http://localhost:1234/v1
# OPENAI_COMPAT_KEY=

# Claude (paid)
# ANTHROPIC_API_KEY=

# Model new agents use, e.g. ollama:qwen3:8b or anthropic:claude-opus-5-5 (otherwise picked automatically)
# DEFAULT_MODEL=

# Free web search for non-Claude models via your own SearXNG (otherwise DuckDuckGo)
# SEARXNG_URL=

# Require this token from the app (set it if the server is reachable from the internet)
# STATION_TOKEN=

# PORT=8787
# DATA_DIR=./data

# Voice chat: server-side transcription for browsers without speech recognition (e.g. Firefox).
# Your own OpenAI-compatible Whisper server (free, private), e.g. Speaches:
# WHISPER_URL=http://localhost:8000/v1
# WHISPER_MODEL=Systran/faster-whisper-small
# (Or leave unset and set GROQ_API_KEY to use Groq's free Whisper tier.)

# Voice server for studio voices and cloning (voice-clone/voice_server.py)
# VOICE_URL=http://127.0.0.1:8890
